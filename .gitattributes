# Preserve original upstream notices byte-for-byte, including their line endings.
# Upstream README underline separators are not Git conflict markers.
Sources/EliteCore/Resources/ModelLicenses/** conflict-marker-size=32 -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
Sources/EliteCore/Resources/*-LICENSE.txt -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
Sources/EliteCore/Resources/Vector-MANIFEST.txt -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
Sources/EliteCore/Resources/Legal/CC-*.txt -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
