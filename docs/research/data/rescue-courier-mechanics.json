    "states": {
      "GLOBAL": {
        "ENTER": [
          "setStateTo: HUNT_PLAYER"
        ]
      },
      "ATTACK_PLAYER": {
        "ENTER": [
          "setSpeedFactorTo: 1",
          "performIdle",
          "pauseAI: 1"
        ],
        "RESTARTED": [
          "setStateTo: HUNT_PLAYER"
        ],
        "NOTHING_FOUND": [
          "setStateTo: HUNT_PLAYER"
        ],
        "UPDATE": [
          "scanForNearestShipWithRole: player"
        ],
        "TARGET_FOUND": [
          "setTargetToFoundTarget",
          "fireMissile",
          "setAITo: interceptAI.plist"
        ]
      },
      "HUNT_PLAYER": {
        "ATTACKED": [
          "setTargetToPrimaryAggressor",
          "setAITo: interceptAI.plist"
        ],
        "RESTARTED": [
          "pauseAI: 2"
        ],
        "PLAYER_FOUND": [
          "setStateTo: ATTACK_PLAYER"
        ],
        "UPDATE": [
          "sendScriptMessage: findPlayer",
          "setDestinationFromCoordinates",
          "setDesiredRangeTo: 15000",
          "setSpeedFactorTo: 2",
          "performFlyToRangeFromDestination",
          "pauseAI: 2"
        ]
      }
    }
  },
